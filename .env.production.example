# ── STRIDE Production Secrets ──────────────────────────────────────────────────
# Copy this file, fill in values, then set each secret via:
#   flyctl secrets set --app stride-host KEY=value
#   flyctl secrets set --app stride-bff  KEY=value
#
# GitHub Actions secret:
#   FLY_API_TOKEN  — from: flyctl auth token
# ──────────────────────────────────────────────────────────────────────────────

# ── stride-host secrets ───────────────────────────────────────────────────────

# Azure SQL free tier connection string
# Format: Server=<server>.database.windows.net;Database=STRIDE;User Id=<user>;Password=<pass>;TrustServerCertificate=false;Encrypt=true;
CONNECTIONSTRINGS__DEFAULTCONNECTION=

# Upstash Redis — copy the "TLS" connection string from the Upstash console
# Format: rediss://:<password>@<host>:6380
REDIS__CONNECTIONSTRING=

# JWT — generate with: openssl rand -base64 48
JWT__SECRET=
JWT__ISSUER=https://stride-host.fly.dev
JWT__AUDIENCE=https://stride-host.fly.dev

# ── stride-bff secrets ────────────────────────────────────────────────────────

# Internal URL of the Host on Fly.io (use fly.dev public URL — no private networking needed)
SERVICES__STRIDEHOST=https://stride-host.fly.dev

# Same Upstash Redis connection string as above
REDIS__CONNECTIONSTRING=

# Random string for session cookie signing — generate with: openssl rand -base64 32
SESSION__SECRET=

# CORS — your Vercel deployment URL (no trailing slash)  [maps to Cors:SpaOrigin in BFF config]
CORS__SPAORIGIN=https://stride.vercel.app

# ── GitHub Actions secrets (set in repo Settings → Secrets) ──────────────────
# FLY_API_TOKEN   — from: flyctl auth token
