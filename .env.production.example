# ── STRIDE Production Secrets ──────────────────────────────────────────────────
# Domain topology:
#   app.strydesuite.com  → Vercel (Angular SPA)
#   api.strydesuite.com  → Fly.io (BFF, public)
#   stride-host.internal → Fly.io (Host, private — no public ingress)
#
# Set each secret via:
#   flyctl secrets set --app stride-host KEY=value
#   flyctl secrets set --app stride-bff  KEY=value
#
# GitHub Actions secret (repo Settings → Secrets → Actions):
#   FLY_API_TOKEN  — from: flyctl auth token
# ──────────────────────────────────────────────────────────────────────────────

# ── stride-host secrets ───────────────────────────────────────────────────────

# Azure SQL free tier — portal.azure.com → SQL Database → free offer tier
# Format: Server=<name>.database.windows.net;Database=STRIDE;User Id=<user>;Password=<pass>;Encrypt=true;TrustServerCertificate=false;
CONNECTIONSTRINGS__DEFAULTCONNECTION=

# Upstash Redis — console.upstash.com → copy the TLS (rediss://) connection string
# Required: Redis backs the BFF session store (JWT never touches the browser).
# Free tier: 10k commands/day — zero cost pre-customer.
REDIS__CONNECTIONSTRING=

# JWT signing — generate: openssl rand -base64 48
JWT__SECRET=
JWT__ISSUER=https://api.strydesuite.com
JWT__AUDIENCE=https://api.strydesuite.com

# ── stride-bff secrets ────────────────────────────────────────────────────────
# Note: SERVICES__STRIDEHOST is already set in fly-bff.toml [env] as
#       http://stride-host.internal:8080 — no secret needed for this.

# Same Upstash Redis connection string as above
REDIS__CONNECTIONSTRING=

# CORS — the Vercel SPA origin (no trailing slash)
CORS__SPAORIGIN=https://app.strydesuite.com

# ── Azure SQL keep-alive (prevents auto-pause during demos) ──────────────────
# Add .github/workflows/keepalive.yml (schedule: '0 */6 * * *') that pings:
#   curl https://api.strydesuite.com/health
# Free within GitHub Actions 2000 min/month limit.
# Also set auto-pause-delay to 168h (max) in the Azure portal.

# ── Fly.io custom domains ─────────────────────────────────────────────────────
# After deploying:
#   flyctl certs add api.strydesuite.com --app stride-bff
# Vercel: Project Settings → Domains → add app.strydesuite.com
