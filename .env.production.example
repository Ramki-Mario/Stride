# ─────────────────────────────────────────────────────────────────────────────
# StrydeSuite — Production secrets template
#
# This file documents every secret/environment variable needed to run StrydeSuite
# in production. Never commit actual values — copy to a secure secrets manager
# or set directly as Azure Container Apps secrets via infra/setup.sh.
#
# Generate a strong JWT secret:
#   node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
# ─────────────────────────────────────────────────────────────────────────────

# ── strydesuite-host ──────────────────────────────────────────────────────────

# Azure SQL Database connection string (free serverless tier)
# Server:   stryde-suite-db-server.database.windows.net (Central India, already created)
# Database: stryde-suite-db
# Format: Server=tcp:stryde-suite-db-server.database.windows.net,1433;Database=stryde-suite-db;
#         User Id=<userId>;Password=<pass>;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;
ConnectionStrings__DefaultConnection=

# Redis Cloud TLS connection string (free 30 MB tier)
# Format: rediss://:<password>@<host>:<port>
Redis__ConnectionString=

# JWT signing key — must be the same value in both strydesuite-host and strydesuite-bff
# Minimum 32 characters; 64+ recommended.
Jwt__Secret=

# JWT issuer and audience — must match the values Angular expects.
# These defaults work out of the box; only change if you customise the tokens.
Jwt__Issuer=StrydeSuite
Jwt__Audience=StrydeSuite.Clients

# ── strydesuite-bff ───────────────────────────────────────────────────────────

# Internal URL of strydesuite-host within the Azure Container Apps environment.
# Set automatically by infra/setup.sh — do not change manually.
# Format: http://strydesuite-host.internal.<env-domain>
Services__StrideHost=

# Same Redis connection string as above (BFF uses Redis as session store)
Redis__ConnectionString=

# CORS: Angular SPA origin (Vercel deployment or custom domain)
Cors__SpaOrigin=https://app.strydesuite.com

# ── GitHub Actions secrets ────────────────────────────────────────────────────
# Add these in: GitHub repo → Settings → Secrets and variables → Actions

# AZURE_CREDENTIALS  — JSON output of `az ad sp create-for-rbac --sdk-auth`
#                       Printed by infra/setup.sh at the end.

# GHCR_TOKEN         — GitHub Personal Access Token with scope: read:packages
#                       Used by Azure Container Apps to pull images from GHCR.
#                       Create at: GitHub → Settings → Developer settings → PATs
