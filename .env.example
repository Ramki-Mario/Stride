# Copy this file to .env and fill in your local values.
# .env is gitignored — never commit secrets.

# SQL Server — Windows Authentication (local SQLEXPRESS)
ConnectionStrings__DefaultConnection=Server=YOUR_MACHINE\SQLEXPRESS;Database=STRIDE;Integrated Security=true;TrustServerCertificate=true;

# SQL Server — SQL Authentication (Docker / Azure / CI)
# ConnectionStrings__DefaultConnection=Server=localhost,1433;Database=STRIDE;User Id=sa;Password=YourStrong@Password123;TrustServerCertificate=true;

# Redis Cloud
Redis__ConnectionString=your-host.redis.cloud:port,password=yourpassword,ssl=True,abortConnect=False

# JWT (Phase 2)
Jwt__Secret=
Jwt__Issuer=STRIDE
Jwt__ExpiryMinutes=480

# Seq structured logging (Phase 5 — skip for local dev)
Seq__ServerUrl=

# Application Insights (Phase 5)
ApplicationInsights__ConnectionString=

# Angular BFF origin
Cors__SpaOrigin=http://localhost:4200

# BFF → Host internal URL
Services__StrideHost=http://localhost:5001
