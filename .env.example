# Copy this file to .env and fill in your local values.
# .env is gitignored — never commit secrets.

# SQL Server — Windows Authentication (local SQLEXPRESS)
ConnectionStrings__DefaultConnection=Server=YOUR_MACHINE\SQLEXPRESS;Database=StrydeSuite;Integrated Security=true;TrustServerCertificate=true;

# SQL Server — SQL Authentication (Docker / Azure / CI)
# ConnectionStrings__DefaultConnection=Server=localhost,1433;Database=StrydeSuite;User Id=sa;Password=YourStrong@Password123;TrustServerCertificate=true;

# Redis Cloud
Redis__ConnectionString=your-host.redis.cloud:port,password=yourpassword,ssl=True,abortConnect=False

# JWT
# Jwt__Secret MUST be at least 32 bytes (256 bits) of random entropy for HS256.
# Generate locally with: openssl rand -base64 48   (or)   [Convert]::ToBase64String((1..48 | %{ Get-Random -Max 256 }))
Jwt__Secret=
Jwt__Issuer=StrydeSuite
Jwt__Audience=StrydeSuite.Clients
Jwt__ExpiryMinutes=480

# Redis key prefix (optional — namespace this env's data inside a shared Redis)
Redis__KeyPrefix=strydesuite-dev

# Seq structured logging (skip for local dev)
Seq__ServerUrl=

# Application Insights
ApplicationInsights__ConnectionString=

# Angular BFF origin
Cors__SpaOrigin=http://localhost:4200

# BFF → Host internal URL
Services__StrideHost=http://localhost:5001
