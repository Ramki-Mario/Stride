# Copy this file to .env and fill in your local values.
# .env is gitignored — never commit secrets.

# SQL Server
SQL_SA_PASSWORD=YourStrong@Password123

# STRIDE.Host connection string
ConnectionStrings__DefaultConnection=Server=localhost,1433;Database=STRIDE;User Id=sa;Password=YourStrong@Password123;TrustServerCertificate=true;

# Redis
Redis__ConnectionString=localhost:6379

# JWT (Phase 2)
Jwt__Secret=

# Seq structured logging
Seq__ServerUrl=http://localhost:5341

# Application Insights (Phase 5)
ApplicationInsights__ConnectionString=

# Angular BFF origin
Cors__SpaOrigin=http://localhost:4200

# BFF → Host internal URL
Services__StrideHost=http://localhost:5001
