{
  "Services": {
    "StrideHost": "http://localhost:5001"
  },
  "Cors": {
    "SpaOrigin": "http://localhost:4200"
  },
  "Redis": {
    "ConnectionString": "redis-18113.crce300.ap-south-1-2.ec2.cloud.redislabs.com:18113,password=1234,ssl=True,sslProtocols=Tls12,abortConnect=False"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
